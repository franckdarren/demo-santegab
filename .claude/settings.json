{
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npx prisma *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Read(**/*)",
      "Write(app/**/*)",
      "Write(components/**/*)",
      "Write(lib/**/*)",
      "Write(prisma/schema.prisma)",
      "Write(prisma/seed.ts)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(npx prisma migrate reset *)",
      "Write(.env*)",
      "Write(prisma/migrations/**/*)"
    ]
  }
}